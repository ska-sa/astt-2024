                <mxCell id="overview-2" parent="1" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" value="ASTT-020 — simple wiring overview" vertex="1">
                    <mxGeometry height="36" width="650" x="40" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="overview-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="The two MPU6050 modules share GND, 3V3, SDA GPIO21 and SCL GPIO22. The fixed MPU checks whether the base/dish is level. The moving MPU follows the elevation axis and measures elevation." vertex="1">
                    <mxGeometry height="75" width="620" x="720" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="overview-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="LOLIN32&#xa;&#xa;AZ motor: GPIO25 IN1, GPIO26 IN2, GPIO27 ENA&#xa;EL motor: GPIO32 IN3, GPIO33 IN4, GPIO18 ENB&#xa;AZ encoder: GPIO19&#xa;EL encoder: GPIO35 reserved&#xa;E-stop sense: GPIO23&#xa;I2C: GPIO21 SDA, GPIO22 SCL" vertex="1">
                    <mxGeometry height="300" width="330" x="60" y="145" as="geometry"/>
                </mxCell>
                <mxCell id="overview-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="L298N&#xa;&#xa;Channel A — azimuth&#xa;IN1  GPIO25&#xa;IN2  GPIO26&#xa;ENA  GPIO27 PWM&#xa;OUT1/OUT2 → AZ motor&#xa;&#xa;Channel B — elevation&#xa;IN3  GPIO32&#xa;IN4  GPIO33&#xa;ENB  GPIO18 PWM&#xa;OUT3/OUT4 → EL motor" vertex="1">
                    <mxGeometry height="300" width="330" x="940" y="145" as="geometry"/>
                </mxCell>
