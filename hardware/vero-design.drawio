                <mxCell id="placement-106" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="IMPORTANT&#xa;&#xa;H9 is the fixed level-reference MPU.&#xa;&#xa;H10 moves with the elevation axis. Tie its AD0/address pad HIGH so it is 0x69.&#xa;&#xa;Both use the same four I2C bus wires.&#xa;&#xa;GPIO35 is input-only and remains unused until an EL encoder is fitted." vertex="1">
                    <mxGeometry height="270" width="500" x="800" y="120" as="geometry"/>
                </mxCell>
                <mxCell id="placement-107" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="L298 sits above/off the Veroboard&#xa;&#xa;H3 → channel A control&#xa;H5 → channel B control&#xa;H6 ← checked 5 V output + common GND&#xa;&#xa;12 V, OUT1/2 and OUT3/4 use the L298 screw terminals directly." vertex="1">
                    <mxGeometry height="210" width="500" x="800" y="430" as="geometry"/>
                </mxCell>
                <mxCell id="placement-108" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="Measure the real LOLIN32 header spacing and board hole count before cutting or soldering." vertex="1">
                    <mxGeometry height="75" width="500" x="800" y="680" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
